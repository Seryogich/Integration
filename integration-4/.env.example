# Non-sensitive configuration only. Secrets live in ./secrets/
POSTGRES_USER=orders
POSTGRES_DB=orders

# Host port of the Orders API (the single external entry point).
ORDERS_PORT=8000

# MLflow UI (operator tool, not a client API).
MLFLOW_PORT=5000

# Model resolution (Practice 4)
MODEL_NAME=house-price
MODEL_ALIAS=prod

# Forecast API settings (the service itself is NOT published to the host).
FORECAST_TIMEOUT=5
FORECAST_DELAY_SEC=0
BATCH_MAX_ITEMS=50

# JWT lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
