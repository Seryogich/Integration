# Non-sensitive configuration only. Secrets live in ./secrets/ (see secrets/README.md).
POSTGRES_USER=orders
POSTGRES_DB=orders

# Host port of the Orders API (the single external entry point).
ORDERS_PORT=8000

# Forecast API settings (the service itself is NOT published to the host).
MODEL_VERSION=v1
FORECAST_TIMEOUT=3

# Practice 3: artificial latency of the Forecast API (seconds), request timeout, batch limit.
FORECAST_DELAY_SEC=1.0
BATCH_MAX_ITEMS=50

# JWT lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
